#!/usr/bin/env python
import os
import sys
from pathlib import Path
from shutil import which
from subprocess import *


def in_git_repo():
    """Determine whether the working directory is inside a git repository."""
    out = run([which("git"), "status"], stdout=DEVNULL, stderr=DEVNULL)
    return out.returncode == 0


def git_untracked_files():
    """Determine whether there are any untracked files in the working
    git repository."""
    out = run(
        [
            which("git"),
            "ls-files",
            "--others",
            "--directory",
        ],
        capture_output=True,
        check=True,
    )
    return out.stdout.strip() != b""


def git_clean():
    """Run git clean in the working git repository."""
    check_call([which("git"), "clean", "-dffx"])


if __name__ == "__main__":
    paru_cache = (
        Path(os.getenv("XDG_CACHE_HOME", default=os.getenv("HOME") + "/.cache"))
        / "paru/clone"
    )
    if not paru_cache.is_dir():
        print("Paru cache not found", file=sys.stderr)
        exit(1)

    for subdir in [x for x in paru_cache.iterdir() if x.is_dir()]:
        os.chdir(subdir)
        if in_git_repo() and git_untracked_files():
            print(f"Cleaning {subdir.name}...")
            git_clean()
            print()
