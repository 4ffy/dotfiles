#!/usr/bin/env python
import os
import sys
from argparse import ArgumentParser
from subprocess import *
from tempfile import NamedTemporaryFile


def concat(videos, dest):
    with NamedTemporaryFile() as temp:
        for video in videos:
            temp.write(f"file '{video}'\n".encode("utf8"))
        temp.seek(0)
        check_call(
            [
                "ffmpeg",
                "-f",
                "concat",
                "-safe",
                "0",
                "-i",
                temp.name,
                "-c",
                "copy",
                dest,
            ]
        )


if __name__ == "__main__":
    parser = ArgumentParser(
        "cat-videos",
        description="""Concatenate videos using ffmpeg. The videos should be
        similar i.e. be the same size, format and encoding.""",
    )
    parser.add_argument(
        "videos", metavar="VIDEO", nargs="+", help="input videos"
    )
    parser.add_argument(
        "-o", "--output", metavar="FILE", required=True, help="output filename"
    )
    args = parser.parse_args()

    bad = False
    for file in args.videos:
        if not os.path.exists(file):
            print(f"file not found: '{file}'", file=sys.stderr)
            bad = True
            continue
        if not os.path.isfile(file):
            print(f"not a file: '{file}'", file=sys.stderr)
            bad = True
            continue
        if not os.access(file, os.R_OK):
            print(f"file not readable: '{file}'", file=sys.stderr)
            bad = True
            continue
    if bad:
        exit(1)

    videos = [os.path.abspath(x) for x in args.videos]

    try:
        concat(videos, args.output)
    except CalledProcessError as err:
        print(err, file=sys.stderr)
        exit(1)
